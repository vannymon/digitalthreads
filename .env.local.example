# Both of these are optional.

# The default analyser runs on this machine through Ollama — no key, no cost,
# nothing leaves the laptop. Override these only if your setup differs.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3.6

# Only needed if you want the "Claude" option in the analyser toggle, which
# gives a sharper read at the cost of tokens. The app works fully without it.
ANTHROPIC_API_KEY=
